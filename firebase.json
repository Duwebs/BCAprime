{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.git/**",
      "**/.git",
      "**/.firebase/**",
      "**/.agents/**",
      "**/.claude/**",
      "**/.vscode/**",
      "**/supabase/**",
      "**/node_modules/**",
      "**/*.sql",
      "**/*.secret.txt",
      "vapid-keys-PRIVATE.txt",
      "newsecret.txt"
    ],
    "rewrites": [
      {
        "source": "/analytics",
        "destination": "/analytics/index.html"
      },
      {
        "source": "/analytics/**",
        "destination": "/analytics/index.html"
      }
    ]
  }
}
