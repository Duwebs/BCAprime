{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build:css",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/analytics", "destination": "/analytics/index.html" },
    { "source": "/analytics/(.*)", "destination": "/analytics/index.html" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  }
}