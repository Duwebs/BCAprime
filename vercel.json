{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build:css",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.json)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.svg)",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/analytics", "destination": "/analytics/index.html" },
    { "source": "/analytics/(.*)", "destination": "/analytics/index.html" },
    { "source": "/resource/:id/og", "destination": "/api/og?id=:id" },
    { "source": "/resource/:id", "destination": "/api/resource?id=:id" }
  ],
  "functions": {
    "api/og.jsx": {
      "runtime": "edge"
    },
    "api/*.js": {
      "maxDuration": 30
    }
  }
}