{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.json)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.svg)",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.xml)",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=14400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=14400" }
      ]
    },
    {
      "source": "/(.*\\.webmanifest)",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/stats/stats-manifest.webmanifest", "destination": "/stats-manifest.webmanifest" },
    { "source": "/stats/stats-manifest.json", "destination": "/stats-manifest.json" },
    { "source": "/admin/admin-manifest.webmanifest", "destination": "/admin-manifest.webmanifest" },
    { "source": "/admin/admin-manifest.json", "destination": "/admin-manifest.json" },
    { "source": "/stats", "destination": "/analytics/index.html" },
    { "source": "/stats/", "destination": "/analytics/index.html" },
    { "source": "/stats/:file(.*)", "destination": "/analytics/:file" },
    { "source": "/analytics", "destination": "/analytics/index.html" },
    { "source": "/analytics/", "destination": "/analytics/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin.css", "destination": "/admin/admin.css" },
    { "source": "/admin.js", "destination": "/admin/admin.js" },
    { "source": "/analytics.css", "destination": "/analytics/analytics.css" },
    { "source": "/analytics.js", "destination": "/analytics/analytics.js" },
    { "source": "/resource/:id/og", "destination": "/api/og?id=:id" },
    { "source": "/resource/:id", "destination": "/api/resource?id=:id" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  }
}
