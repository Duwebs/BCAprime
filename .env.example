# ============================================================
# BCAPrime — Environment Variables Template
# Copy this file to .env.local for local development.
# On Vercel, configure these in Project Settings -> Environment Variables.
# ============================================================

# Supabase Public Keys (available in client bundles)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server Keys (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend API for transactional emails (OTP, welcome, etc.)
RESEND_API_KEY=re_your_resend_api_key

# Telegram Bot for New User Signups (Supabase Edge Function: telegram-new-user)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# BCAPrime Admin Telegram Bot (Admin Activity Alerts & Moderation)
# Server-side only (Vercel Functions / API routes)
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
