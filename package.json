{
  "name": "bcaprime",
  "version": "3.1.5",
  "private": true,
  "description": "BCAPrime — BCA study library (static site + Vercel serverless auth/email functions)",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/generate-env.js && vercel dev",
    "build": "npm run build:css && node scripts/generate-env.js && echo 'Static site: Tailwind CSS rebuilt + env.js generated.'",
    "build:css": "tailwindcss -i tailwind.input.css -o tailwind.css --minify",
    "docs:email": "vercel env add RESEND_API_KEY"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/og": "^0.6.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
