{
  "name": "bcaprime",
  "version": "2.0.0",
  "private": true,
  "description": "BCAPrime — BCA study library (static site + Vercel serverless auth/email functions)",
  "type": "commonjs",
  "scripts": {
    "dev": "vercel dev",
    "build": "npm run build:css && echo 'Static site: Tailwind CSS rebuilt.'",
    "build:css": "tailwindcss -i tailwind.input.css -o tailwind.css --minify",
    "docs:email": "vercel env add RESEND_API_KEY"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "firebase-admin": "^12.2.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
